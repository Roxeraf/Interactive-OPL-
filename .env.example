DATABASE_URL="file:./dev.db"
AUTH_SECRET="bitte-durch-einen-langen-zufaelligen-wert-ersetzen"
UPLOAD_DIR="./uploads"

# Docker (docker compose up) setzt DATABASE_URL automatisch auf
# file:/data/klarpunkt.db und persistiert die Datei im Volume klarpunkt-data.
# Hochgeladene OPL-Dokumente liegen dort unter /data/uploads.
